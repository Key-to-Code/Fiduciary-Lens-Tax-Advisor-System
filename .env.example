# ─── Backend environment variables ─────────────────────────────────────────
# Copy this file to .env in the PROJECT ROOT (not in backend/).
# The backend reads from the same .env as the RAG/NLP pipeline.
#
#   cp .env.example .env   # then fill in real values
#
# ─── LLM provider (required for RAG & NLP pipeline) ────────────────────────

# Which LLM backend to use: openai | ollama | local | extractive | auto
LLM_PROVIDER=openai

# OpenAI / OpenRouter API key — required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openrouter_or_openai_key_here

# Optional: override the base URL (e.g. OpenRouter endpoint)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model to use with the OpenAI-compatible provider
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# ─── Hugging Face (required for the embedding model) ───────────────────────
HF_TOKEN=your_hugging_face_token_here

# ─── Ollama (only needed when LLM_PROVIDER=ollama) ─────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── FastAPI backend settings ───────────────────────────────────────────────
APP_NAME=Fiduciary Lens Tax Advisor API
APP_VERSION=0.1.0
APP_ENV=development

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins (no trailing slashes)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── RAG pipeline tuning (optional — defaults are sensible) ─────────────────
# EMBED_MODEL=ai4bharat/indic-bert
# TOP_K=6
# CANDIDATE_K=30
# MIN_SCORE=0.60
# DENSE_WEIGHT=0.65
# MAX_TOKENS=800
# TEMPERATURE=0.1

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/legal_summarizer
